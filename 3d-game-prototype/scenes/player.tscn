[gd_scene format=3 uid="uid://box_player_001"]

; =============================================================
; player.tscn  —  Box Player (no camera inside)
;
; THE FIX — WHY CAMERA IS NO LONGER A CHILD OF PLAYER:
;   When the camera is a child of the player, rotating the player
;   also rotates the camera. This changes cam_forward every frame,
;   which changes move_dir, which rotates the player again — an
;   infinite feedback loop that causes rapid spinning.
;
;   The camera now lives in main.tscn as a sibling of Player.
;   player.gd repositions it every frame to follow the player
;   in world space, completely independent of player rotation.
;
; SCENE TREE:
;   Player (CharacterBody3D)
;   ├── MeshInstance3D      ← blue box
;   ├── CollisionShape3D    ← box collider
;   └── ArrowMarker         ← yellow arrow on top showing forward
; =============================================================

[ext_resource type="Script" path="res://scripts/player.gd" id="1_player"]

[sub_resource type="BoxMesh" id="BoxMesh_player"]
size = Vector3(1.0, 1.0, 1.0)

[sub_resource type="StandardMaterial3D" id="Mat_player"]
albedo_color = Color(0.18, 0.48, 1.0, 1)
roughness = 0.5
metallic = 0.1

[sub_resource type="BoxShape3D" id="BoxShape_player"]
size = Vector3(1.0, 1.0, 1.0)

[sub_resource type="PrismMesh" id="Mesh_arrow"]
size = Vector3(0.5, 0.08, 0.7)

[sub_resource type="StandardMaterial3D" id="Mat_arrow"]
albedo_color = Color(1.0, 0.9, 0.0, 1)
roughness = 0.4
emission_enabled = true
emission = Color(0.8, 0.7, 0.0, 1)
emission_energy_multiplier = 0.6

[node name="Player" type="CharacterBody3D"]
script = ExtResource("1_player")

[node name="MeshInstance3D" type="MeshInstance3D" parent="."]
position = Vector3(0.0, 0.5, 0.0)
mesh = SubResource("BoxMesh_player")
surface_material_override/0 = SubResource("Mat_player")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
position = Vector3(0.0, 0.5, 0.0)
shape = SubResource("BoxShape_player")

; Arrow sits on top of box, points toward local +Z (front of box)
; Rotated -90° on X to lay flat
[node name="ArrowMarker" type="MeshInstance3D" parent="."]
position = Vector3(0.0, 1.05, 0.0)
rotation = Vector3(-1.5708, 0.0, 0.0)
mesh = SubResource("Mesh_arrow")
surface_material_override/0 = SubResource("Mat_arrow")
